---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Accueil">
  <div class="hero">
    <h1 class="charm-font">Alain Humeau</h1>
    <h2>alias Loup_1234</h2>
    <div>
      <md-icon-button href="mailto:alainhumeaubui@gmail.com" aria-label="Email">
        <svg viewBox="0 0 24 24"><path d="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z" fill="currentColor" /></svg>
      </md-icon-button>

      <md-icon-button href="https://linkedin.com/in/humeaubuialain" target="_blank" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24"><path d="M19 3A2 2 0 0 1 21 5V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5 3H19M18.5 18.5V13.2A3.26 3.26 0 0 0 15.24 9.94C14.39 9.94 13.4 10.46 12.92 11.24V10.13H10.13V18.5H12.92V13.57C12.92 12.8 13.54 12.17 14.31 12.17A1.4 1.4 0 0 1 15.71 13.57V18.5H18.5M6.88 8.56A1.68 1.68 0 0 0 8.56 6.88C8.56 5.95 7.81 5.19 6.88 5.19A1.69 1.69 0 0 0 5.19 6.88C5.19 7.81 5.95 8.56 6.88 8.56M8.27 18.5V10.13H5.5V18.5H8.27Z" fill="currentColor" /></svg>
      </md-icon-button>
      
      <md-icon-button href="https://github.com/Loup-1234" target="_blank" aria-label="GitHub">
        <svg viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z" fill="currentColor" /></svg>
      </md-icon-button>
    </div>
  </div>

  <div class="grid-2-cols">
    <section>
      <h2 class="section-title">Profil</h2>
      <p style="line-height: 1.8;">
        Passionné par la programmation, je suis actuellement en BTS CIEL (Cybersécurité, Informatique et réseaux, Électronique) option A (Informatique et Réseaux) à Saint-Gabriel à Saint-Laurent-sur-Sèvre.<br><br>
        Lauréat du prix STEM for ALL de Thales Solidarity, je m'apprête à intégrer le cycle ingénieur de l'IMT Atlantique en filière Ingénierie Logicielle.<br><br>
        Mon but est de renforcer mes compétences pour devenir DevOps ou développeur full-stack.<br><br>
        Pour rester à jour avec les dernières technologies, je mène des projets personnels que je publie sur GitHub, ce qui me permet de découvrir de nouvelles méthodes et d'élargir mes connaissances.
      </p>
    </section>

    <section>
      <h2 class="section-title">Centres d'intérêts</h2>
      <ul style="grid-area: ul; line-height: 1.8; margin-left: -24px;">
        <li>Passion pour la programmation informatique.</li>
        <li>Apprentissage de Java, Kotlin et Rust en autodidacte.</li>
        <li>Utilisation d'Arch Linux comme OS principal.</li>
        <li>Création de sites web, d'applications PC / Android et de jeux vidéo.</li>
        <li>Grand intérêt pour la culture japonaise et orientale.</li>
        <li>Pratique du dessin pour me détendre.</li>
      </ul>
    </section>
  </div>
</Layout>

<style>
  .hero { 
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 150px); 
    text-align: center; 
    margin-bottom: 64px; 
  }
  .charm-font { font-family: 'Charm', cursive; font-size: clamp(4rem, 10vw, 8rem); margin: 0; }
  .grid-2-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .section-title { color: var(--md-sys-color-primary);}
  .interest-list { border-radius: 16px; background-color: var(--md-sys-color-surface-container); overflow: hidden; }
  @media (max-width: 800px) { .grid-2-cols { grid-template-columns: 1fr; } }
</style>